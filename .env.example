# Production: connect a Turso Cloud database and a PRIVATE Vercel Blob store.
# Keep credentials in Vercel environment variables, never NEXT_PUBLIC_*.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Also accepts TURSO_DATABASE_AUTH_TOKEN when the integration uses
# the custom prefix TURSO_DATABASE. Set only the token name supplied by Turso.
BLOB_READ_WRITE_TOKEN=

# Local testing only (do not set in Vercel):
# PHI_LOCAL_STORAGE=1
# TURSO_DATABASE_URL=file:.data/vault.db
